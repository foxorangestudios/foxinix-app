# Foxinix server — copiar a .env y completar
# Segredo JWT (obtener con: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
FOXMSG_SECRET=

# Resend (https://resend.com) — API key con dominio foxinix.qzz.io verificado
# Si queda vacío, los correos se escriben en data/mail.log (modo prueba)
RESEND_API_KEY=
MAIL_FROM=Foxinix <no-reply@foxinix.qzz.io>

# Datos (por defecto: <directorio del repo>/server/data)
# FOXMSG_DATA=/home/FoxOrange/chat-server/data

# Cuota de medios en bytes (default 1 GB)
FOXMSG_MEDIA_QUOTA=1073741824

# Puerto HTTP
FOXMSG_PORT=8444
